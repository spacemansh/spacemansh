{
  "name": "spacemansh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm registry:build && next build",
    "deploy": "pnpm registry:build && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "pnpm registry:build && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "quality": "pnpm lint && pnpm format",
    "quality:fix": "pnpm lint:fix && pnpm format:fix",
    "registry:build": "shadcn build && pnpm registry:check",
    "registry:check": "node scripts/check-registry.mjs",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@opennextjs/cloudflare": "1.19.11",
    "@radix-ui/react-slot": "1.3.0",
    "@space-man/react-theme-animation": "2.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.21.0",
    "motion": "12.40.0",
    "next": "16.2.9",
    "radix-ui": "1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-use-measure": "2.1.7",
    "shadcn": "4.11.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "antislop-plugin": "0.1.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "wrangler": "4.101.0"
  },
  "packageManager": "pnpm@10.18.3"
